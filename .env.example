# Copy this file to .env and fill in only what you need. .env is already in .gitignore --
# never commit real credentials. All of this is optional: with no .env file and none of
# these variables set, the AMD Streamlit app runs entirely in local deterministic mode, with
# no network call and no credential required.
#
# Hard safety rule: LLM_ALLOW_EXTERNAL_CALLS must be explicitly "true" before Groq or AMD
# Token Factory can ever be invoked. Setting GROQ_API_KEY alone -- even a real one sitting in
# your shell's ambient environment -- is never, by itself, enough to authorize a live call.
# See hackathon/amd/llm_config.py.

# Where to find a real local RSNA knee data_root (train.csv, raw/train_series/...) and a real
# foldN-knee-mil-best.ckpt checkpoint. Optional -- leave blank to type both into the Streamlit
# sidebar instead. Works identically on Windows and Linux/Railway; use whichever path syntax
# your OS expects (pathlib.Path handles both -- see hackathon/amd/data_config.py):
#   Windows example:  AMD_KAGGLE_RSNA_ROOT=D:\path\to\rsna-knee
#   Linux example:    AMD_KAGGLE_RSNA_ROOT=/app/data/rsna-knee
AMD_KAGGLE_RSNA_ROOT=
AMD_KAGGLE_CHECKPOINT=

# Which optional LLM reasoning provider to use: local (default), groq, or amd_token_factory.
LLM_PROVIDER=local

# Master switch for any external network call from the optional LLM reasoning layer.
# Must be "true" (case-insensitive; "1"/"yes"/"on" also accepted) for LLM_PROVIDER=groq or
# amd_token_factory to ever actually run instead of silently falling back to local mode.
LLM_ALLOW_EXTERNAL_CALLS=false

# Groq (https://console.groq.com) -- an OpenAI-compatible chat-completions API.
# GROQ_MODEL must be one of Groq's current production model IDs (see console.groq.com/docs/models
# -- this list changes over time). openai/gpt-oss-20b is used here as a small, broadly-available
# default; llama-3.3-70b-versatile returned "model does not exist or you do not have access to
# it" (HTTP 404) for at least one real key tested during development, despite being listed as a
# production model -- availability can be account/tier-specific, so verify with a real call
# before relying on any specific model ID.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# AMD Token Factory -- disabled by default. This project has no real Token Factory LLM
# client yet; AMD_TOKENFACTORY_ENABLED=true only changes the status message shown in the UI,
# it never causes a real call to succeed (see hackathon/amd/llm_providers.AMDTokenFactoryLLMAdapter).
# No official AMD Token Factory REST API contract (endpoint, auth, request/response shape)
# has been verified for this project -- AMD_TOKENFACTORY_BASE_URL/MODEL are read and surfaced
# in config diagnostics, but propose() always raises NotImplementedError regardless of their
# value. Verify your base URL against official AMD documentation before trusting it with
# anything -- "Token Factory" as a public chat-completions API is a different company's
# (Nebius) product name, not confirmed to be an AMD one.
AMD_TOKENFACTORY_ENABLED=false
AMD_TOKENFACTORY_API_KEY=
AMD_TOKENFACTORY_BASE_URL=
AMD_TOKENFACTORY_MODEL=
