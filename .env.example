# Example environment configuration for local development.
# Copy this file to .env and customize for your environment.
# NEVER commit .env with real API keys or credentials to Git.

LOCAL_IMAGE_EVIDENCE_ENABLED=true
EXPLANATION_MODE=deterministic
BEDROCK_ENABLED=false
GROQ_ENABLED=false

# Optional: Enable Bedrock (requires AWS credentials)
# BEDROCK_ENABLED=true
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: Enable Groq (requires GROQ_API_KEY)
# GROQ_ENABLED=true
# GROQ_API_KEY=your_groq_api_key_here
